{
    "name": "aimanong/aimind-client",
    "version": "0.1.0",
    "description": "Aimind 客户端 SDK —— 让 Aimanong 的 AI 能调用 Aimind 互助平台",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "aimanong/core": "^1.6",
        "illuminate/support": "^12.0",
        "illuminate/contracts": "^12.0|^13.0",
        "laravel/mcp": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "Aimanong\\AimindClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimanong\\AimindClient\\AimindClientServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "pint": "vendor/bin/pint"
    },
    "autoload-dev": {
        "psr-4": {
            "Aimanong\\AimindClient\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ]
}
