 * 解析一个关联，返回下拉所需的一切。
 *
 * @param  string  $model  持有该关联的模型类名（如 App\Models\Article）
 * @param  string  $relation  关联方法名（如 author）
 * @param  string|null  $labelColumn  候选显示用哪一列；null = 自动挑
 * @return array{options: array<int, array{value: mixed, label: string}>, exists: string, labelColumn: string}|null
 *                                                                                                                  解析不了时返回 null（不抛异常）——
 *                                                                                                                  编译期会遇到「模型还没建」「表还没迁」这类正常中间态，
 *                                                                                                                  让整个 Resource 编译失败比降级更难排查
 */";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:5;s:9:"endColumn";i:98;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:18:"Aimanong\Contracts";s:18:"declaringClassName";s:35:"Aimanong\Contracts\RelationResolver";s:21:"implementingClassName";s:35:"Aimanong\Contracts\RelationResolver";s:16:"currentClassName";s:35:"Aimanong\Contracts\RelationResolver";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}