O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-6.73.0.5-8.2.29-e28a19c73bb73843686d64286a79754e9322456ed460af6825c8020902d9d3a9";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:8:"filename";s:101:"/Users/zhangyang/dsh_work/01/aimanong/packages/core/src/Exceptions/SortColumnNotDeclaredException.php";}}s:9:"namespace";s:19:"Aimanong\Exceptions";s:4:"name";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:9:"shortName";s:30:"SortColumnNotDeclaredException";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1603:"/**
 * `?sort=` 指向了一个不存在的列。
 *
 * ## 为什么是硬错误，而不是 warning
 *
 * 原先 `sort` 直接透传给 `orderBy()`。列不存在时的行为**取决于数据库**：
 *
 *     SQLite：静默接受 `ORDER BY bogus`，返回未排序数据 → 200
 *     MySQL ：报错 → 500
 *
 * SQLite 那种更糟：调用方拿到 **200 + 一坨看起来正常的数据**，
 * 会以为自己要的排序生效了。
 *
 * 实测（L1/L2 十五题）中两个 agent 分别踩到并明确报上来：
 * 「非法 sort 列被静默忽略，**无法靠报错确认参数被接受**」——
 * 它们最后只能改去看 schema 输出。
 *
 * 这违反宪法 ③「零隐式」（优先级高于 ② 和 ①）：
 * 请求做不到就**说做不到**，不要给一个别的顺序冒充。
 *
 * ## 范围（第二轮修正）
 *
 * 第一版只拦「列根本不存在」—— 理由是「声明过但没标 sortable 的列，
 * `orderBy` 确实生效了，不算欺骗」。
 *
 * **但两轮的 agent 都独立指出了问题**：`?sort=name` 返回 200 并真的按
 * name 排，而同一份 `openapi.json` 里 `sort` 的 enum **只列了声明过
 * `sortable` 的列**。于是文档与行为仍然不一致 —— 只是换了个方向。
 *
 * 更根本的是宪法 ②「声明唯一」：如果 `->sortable()` 拦不住未声明的列，
 * 那这个声明就没有约束力，`sort` 的 enum 也就是个摆设。
 *
 * 所以现在**两种都拦**：
 *   · 列不存在        → 422
 *   · 列存在但没声明  → 422（提示加上 ->sortable()）
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:120;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:39:"Aimanong\Exceptions\AiReadableException";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:4:{s:3:"uri";a:16:{s:18:"declaringClassName";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:21:"implementingClassName";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:4:"name";s:3:"uri";s:9:"modifiers";i:2;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:9;s:9:"endColumn";i:29;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:4:"sort";a:16:{s:18:"declaringClassName";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:21:"implementingClassName";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:4:"name";s:4:"sort";s:9:"modifiers";i:2;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:51;s:7:"endLine";i:51;s:11:"startColumn";i:9;s:9:"endColumn";i:30;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"sortable";a:16:{s:18:"declaringClassName";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:21:"implementingClassName";s:50:"Aimanong\Exceptions\SortColumnNotDeclaredException";s:4:"name";s:8:"sortable";s:9:"modifiers";i:2;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default