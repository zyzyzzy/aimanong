 * 多对多关联写入前的**授权钩子**。
 *
 * ## 为什么需要它
 *
 * 多对多字段（如管理员的「角色」）走 `sync($ids)` 直接落库。
 * 框架原先**不做任何校验** —— 于是：
 *
 *     一个只有 `admin-users.update` 权限的账号，
 *     把 roles 提交成 [超级管理员的角色 id]，
 *     就给自己加上了 super_admin。
 *
 * 实测（2026-10-16）：改前处处 403，改后处处 200 —— 完全提权。
 *
 * 权限系统管的是「你能不能进这个接口」，
 * 管不了「你提交的**这条关联数据**合不合法」—— 后者是业务语义，
 * 只有声明方知道。所以这里开一个默认放行的钩子给声明方覆盖。
 *
 * ## 用法
 *
 *     public static function authorizeRelation(string $relation, array $ids): void
 *     {
 *         if ($relation === 'roles' && ! currentUser()->isSuper()) {
 *             throw new \RuntimeException('不能授予超级管理员角色');
 *         }
 *     }
 *
 * 抛出的异常由控制器统一转成 403。
 *
 * @param  string  $relation  关联方法名（如 roles）
 * @param  array<int, mixed>  $ids  本次要同步过去的 id
 *
 * @throws \Throwable 声明方拒绝时抛出，控制器转成 403
 */";s:9:"startLine";i:158;s:7:"endLine";i:161;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:17;s:9:"namespace";s:8:"Aimanong";s:18:"declaringClassName";s:17:"Aimanong\Resource";s:21:"implementingClassName";s:17:"Aimanong\Resource";s:16:"currentClassName";s:17:"Aimanong\Resource";s:9:"aliasName";N;}s:8:"readonly";a:20:{s:4:"name";s:8:"readonly";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:163;s:7:"endLine";i:166;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:17;s:9:"namespace";s:8:"Aimanong";s:18:"declaringClassName";s:17:"Aimanong\Resource";s:21:"implementingClassName";s:17:"Aimanong\Resource";s:16:"currentClassName";s:17:"Aimanong\Resource";s:9:"aliasName";N;}s:3:"uri";a:20:{s:4:"name";s:3:"uri";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:76:"/**
