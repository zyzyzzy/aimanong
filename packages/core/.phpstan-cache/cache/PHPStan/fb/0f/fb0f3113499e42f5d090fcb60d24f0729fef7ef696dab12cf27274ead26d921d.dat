O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-6.73.0.5-8.2.29-f30eed13b28f8ad9d0063632fd76aa70257f703449c23d94888f8278b32d22b2";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:37:"Aimanong\Contracts\ApplicationContext";s:8:"filename";s:88:"/Users/zhangyang/dsh_work/01/aimanong/packages/core/src/Contracts/ApplicationContext.php";}}s:9:"namespace";s:18:"Aimanong\Contracts";s:4:"name";s:37:"Aimanong\Contracts\ApplicationContext";s:9:"shortName";s:18:"ApplicationContext";s:11:"isInterface";b:1;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1174:"/**
 * 当前请求所属后台的上下文。
 *
 * ## 为什么需要这个契约
 *
 * 多应用下「我在哪个后台」是**每个请求都不同**的信息，
 * 而 `config('aimanong.applications')` 是全局的 —— 直接读配置会被污染。
 * 所以框架规定：**要用前缀/guard 就走 `Aimanong::context()`**。
 * （`ApplicationContextTest` 有一条静态扫描断言盯这件事。）
 *
 * 在此之前 `Aimanong::context()` 的返回类型是 `object`，
 * 于是 core 里的消费者（如 `Extend\Extension::routes()`）
 * 只好用文档注释把变量标注成 `\Aimanong\Application\ApplicationContext`
 * —— 而那个类是 **Laravel 驱动**的，core 不该认识它。
 *
 * ⚠️ 写这段注释时踩过一次：在文档块里写嵌套的「星号 + 斜杠」
 * 会把外层注释**提前闭合**，后面的文字变成代码 → 解析错误。
 * 与 blade 里「注释不保护指令」是同一类坑。
 *
 * 这个契约只放**core 真正需要的**那一个方法；驱动可以有自己的
 * 更宽的类（Laravel 的 `ApplicationContext` 还有 `guard()` /
 * `current()` 等），实现本接口即可。
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:36;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:6:"prefix";a:20:{s:4:"name";s:6:"prefix";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:56:"/**
