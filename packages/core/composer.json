{
    "name": "aimanong/core",
    "version": "1.6.3",
    "description": "Aimanong 框架无关内核 —— 声明 DSL 与四产物编译（零 illuminate 依赖）",
    "type": "library",
    "keywords": [
        "aimanong",
        "ai",
        "admin",
        "dsl",
        "ai-first"
    ],
    "homepage": "https://github.com/zyzyzzy/aimanong",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Aimanong",
            "email": "zyzyzzy@vip.qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Aimanong\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aimanong\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "pint": "vendor/bin/pint"
    }
}
