{
    "name": "aimanong/framework",
    "description": "AI-First admin framework for Laravel — 让任何 AI Agent 5 分钟理解、30 分钟产出后台系统",
    "type": "library",
    "keywords": ["aimanong", "ai", "admin", "laravel", "mcp", "ai-first"],
    "homepage": "https://aimanong.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Aimanong",
            "email": "zyzyzzy@vip.qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "laravel/mcp": "^0.4"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "Aimanong\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aimanong\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse",
        "pint": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimanong\\AimanongServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
