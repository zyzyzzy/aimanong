{
    "name": "aimanong/framework",
    "version": "1.10.0",
    "description": "Aimanong（AI 码农）—— 为 AI Agent 设计的后台开发框架（元包：内核 + Laravel 驱动）",
    "type": "metapackage",
    "keywords": [
        "aimanong",
        "ai",
        "admin",
        "laravel",
        "mcp",
        "ai-first"
    ],
    "homepage": "https://aimanong.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Aimanong",
            "email": "zyzyzzy@vip.qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "aimanong/core": "^1.0",
        "aimanong/laravel": "^1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel",
            "options": {
                "symlink": true
            }
        }
    ],
    "suggest": {
        "aimanong/region": "中国省市区三级联动字段（->region()）。不装也能用框架，只是没有这个字段类型"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
