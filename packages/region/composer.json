{
    "name": "aimanong/region",
    "version": "1.0.1",
    "description": "Aimanong 官方扩展 —— 中国省市区三级联动选择器",
    "type": "library",
    "keywords": [
        "aimanong",
        "region",
        "china",
        "province",
        "city",
        "district"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Aimanong",
            "email": "zyzyzzy@vip.qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "aimanong/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18",
        "laravel/framework": "^12.0|^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Aimanong\\Region\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Aimanong\\Region\\Tests\\": "tests/"
        }
    },
    "extra": {
        "aimanong": {
            "extension": "Aimanong\\Region\\RegionExtension"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "pint": "vendor/bin/pint"
    },
    "minimum-stability": "stable"
}
