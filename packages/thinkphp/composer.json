{
    "name": "aimanong/thinkphp",
    "version": "1.0.2",
    "description": "Aimanong 的 ThinkPHP 8 驱动 —— ThinkORM 数据源 / 模板 / 路由 / 认证",
    "type": "library",
    "keywords": [
        "aimanong",
        "ai",
        "admin",
        "thinkphp",
        "ai-first"
    ],
    "homepage": "https://aimanong.com",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Aimanong",
            "email": "zyzyzzy@vip.qq.com"
        }
    ],
    "require": {
        "aimanong/core": "^1.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php": "^8.2",
        "topthink/framework": "^8.0",
        "topthink/think-template": "^3.0"
    },
    "conflict": {
        "illuminate/support": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Aimanong\\ThinkPHP\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "pint": "pint",
        "test": "echo '单测见 tests/e2e/thinkphp-e2e.php（真实 ThinkPHP 环境）'"
    }
}
