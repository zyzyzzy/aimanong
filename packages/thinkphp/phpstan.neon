includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8

    paths:
        - src
        # core 是同一套代码的另一半，一起分析 ——
        # 分两个 run 会漏掉「跨包签名不兼容」这类问题
        - ../core/src

    tmpDir: /tmp/aimanong-tp-phpstan

    # 忽略规则本身不必逐条命中（TP 各小版本的方法表有差异）
    reportUnmatchedIgnoredErrors: false

    # TP 的全局助手（session() / config() / app() …）—— 不加载会报 function.notFound
    bootstrapFiles:
        - vendor/topthink/framework/src/helper.php
        - vendor/topthink/think-helper/src/helper.php

    ignoreErrors:
        # ThinkPHP 的 Model 大量使用 __call / __callStatic 动态转发
        # （find / where / save / getAttr …），静态分析看不到。
        # 这些方法在运行时存在，且有 e2e 覆盖。
        -
            identifier: method.notFound
            paths:
                - src/Models/*.php
                - src/ThinkDataSource.php
                - src/Auth/ThinkGuard.php
        -
            identifier: staticMethod.notFound
            paths:
                - src/Models/*.php
                - src/Console/InstallCommand.php
        # 关系属性的读取走 TP 的 __get（roles() 方法 → $model->roles）
        #
        # HomeController 也算在内：控制台要显示当前用户的角色名，
        # 读的就是 $user->roles（那里判的是 Permissible 契约，
        # 运行时由 ORM 的 __get 解析成关系）。
        -
            identifier: property.notFound
            paths:
                - src/Models/*.php
                - src/ThinkPermissionChecker.php
                - src/Http/HomeController.php
        # getFields() 在 think\db\Query 上（Db::table() 返回的是它），
        # 但类型声明写的是 BaseQuery —— 运行时可用，e2e 覆盖了
        -
            message: '#Call to an undefined method think\\db\\BaseQuery::getFields\(\)#'
        # TP 的 Validate 构造函数在 stub 里是 0 参数，实际接受 (rules, messages)
        -
            message: '#Class think\\Validate constructor invoked with 2 parameters#'
        #
        # ⚠️ 空实现的返回值本来就「只返回 null」，PHPStan 的 bleedingEdge
        # 会说返回类型里的 object 部分没用上。这是**刻意的** ——
        # 它要和服务端真实 guard 的签名一致，只是当前实现恒为 null。
        #
        # 2026-10-16：路径从 src/NullRuntime.php 改成拆出来的三个文件
        #（那个文件名与类名都不匹配，PSR-4 加载不到，已拆开）。
        -
            identifier: return.unusedType
            paths:
                - src/NullGuard.php
                - src/NullContext.php
                - src/NullExtensions.php
